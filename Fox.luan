function setStatus(txt)
    pcall(function() StatusBar.Text = "  " .. tostring(txt) end)
end

local Tabs = {}
local ActiveTab = nil

local function switchTab(name)
    for _, page in pairs(Tabs) do
        if page.Frame then page.Frame.Visible = false end
    end
    if Tabs[name] and Tabs[name].Frame then
        Tabs[name].Frame.Visible = true
        ActiveTab = name
        setStatus("tab: " .. name)
    end
end

local function createTab(name, icon)
    local Btn = Instance.new("TextButton")
    Btn.Size = UDim2.new(1, 0, 0, 32)
    Btn.BackgroundColor3 = THEME.BG
    Btn.BackgroundTransparency = 1
    Btn.BorderSizePixel = 0
    Btn.Text = "  " .. (icon or "") .. "  " .. name
    Btn.TextColor3 = THEME.SUBTEXT
    Btn.Font = Enum.Font.GothamSemibold
    Btn.TextSize = 12
    Btn.TextXAlignment = Enum.TextXAlignment.Left
    Btn.ZIndex = 52
    Btn.Parent = Sidebar

    local BtnCorner = Instance.new("UICorner")
    BtnCorner.CornerRadius = UDim.new(0, 6)
    BtnCorner.Parent = Btn

    local Page = Instance.new("ScrollingFrame")
    Page.Size = UDim2.fromScale(1, 1)
    Page.BackgroundTransparency = 1
    Page.BorderSizePixel = 0
    Page.ScrollBarThickness = 3
    Page.ScrollBarImageColor3 = THEME.ACCENT
    Page.CanvasSize = UDim2.new(0, 0, 0, 0)
    Page.AutomaticCanvasSize = Enum.AutomaticSize.Y
    Page.Visible = false
    Page.ZIndex = 52
    Page.Parent = Content

    local PageList = Instance.new("UIListLayout")
    PageList.Padding = UDim.new(0, 6)
    PageList.SortOrder = Enum.SortOrder.LayoutOrder
    PageList.Parent = Page

    Tabs[name] = {Frame = Page, Button = Btn}

    Btn.MouseButton1Click:Connect(function()
        switchTab(name)
        for n, t in pairs(Tabs) do
            if t.Button then
                if n == name then
                    pcall(function()
                        TweenService:Create(t.Button, TweenInfo.new(0.2), {
                            BackgroundTransparency = 0,
                            BackgroundColor3 = THEME.ACCENT,
                            TextColor3 = THEME.TEXT
                        }):Play()
                    end)
                else
                    pcall(function()
                        TweenService:Create(t.Button, TweenInfo.new(0.2), {
                            BackgroundTransparency = 1,
                            TextColor3 = THEME.SUBTEXT
                        }):Play()
                    end)
                end
            end
        end
    end)

    return Tabs[name]
end

local function createSection(parent, text)
    local Sec = Instance.new("TextLabel")
    Sec.Size = UDim2.new(1, 0, 0, 16)
    Sec.BackgroundTransparency = 1
    Sec.Text = string.upper(text)
    Sec.TextColor3 = THEME.ACCENT2
    Sec.Font = Enum.Font.GothamBold
    Sec.TextSize = 10
    Sec.TextXAlignment = Enum.TextXAlignment.Left
    Sec.ZIndex = 53
    Sec.Parent = parent
    return Sec
end

local function createButton(parent, text, callback)
    local Btn = Instance.new("TextButton")
    Btn.Size = UDim2.new(1, 0, 0, 32)
    Btn.BackgroundColor3 = THEME.BG
    Btn.BorderSizePixel = 0
    Btn.Text = "  " .. text
    Btn.TextColor3 = THEME.TEXT
    Btn.Font = Enum.Font.GothamSemibold
    Btn.TextSize = 12
    Btn.TextXAlignment = Enum.TextXAlignment.Left
    Btn.AutoButtonColor = false
    Btn.ZIndex = 53
    Btn.Parent = parent

    local BtnCorner = Instance.new("UICorner")
    BtnCorner.CornerRadius = UDim.new(0, 6)
    BtnCorner.Parent = Btn

    local BtnStroke = Instance.new("UIStroke")
    BtnStroke.Color = THEME.STROKE
    BtnStroke.Thickness = 1
    BtnStroke.Parent = Btn

    Btn.MouseButton1Click:Connect(function()
        setStatus("exec: " .. text)
        if callback then
            local ok, err = pcall(callback)
            if not ok then setStatus("error: " .. tostring(err)) end
        end
    end)
    return Btn
end

local function createToggle(parent, text, default, callback)
    local state = default or false

    local Holder = Instance.new("Frame")
    Holder.Size = UDim2.new(1, 0, 0, 32)
    Holder.BackgroundColor3 = THEME.BG
    Holder.BorderSizePixel = 0
    Holder.ZIndex = 53
    Holder.Parent = parent

    local HolderCorner = Instance.new("UICorner")
    HolderCorner.CornerRadius = UDim.new(0, 6)
    HolderCorner.Parent = Holder

    local HolderStroke = Instance.new("UIStroke")
    HolderStroke.Color = THEME.STROKE
    HolderStroke.Thickness = 1
    HolderStroke.Parent = Holder

    local Label = Instance.new("TextLabel")
    Label.Size = UDim2.new(1, -50, 1, 0)
    Label.Position = UDim2.new(0, 10, 0, 0)
    Label.BackgroundTransparency = 1
    Label.Text = text
    Label.TextColor3 = THEME.TEXT
    Label.Font = Enum.Font.GothamSemibold
    Label.TextSize = 12
    Label.TextXAlignment = Enum.TextXAlignment.Left
    Label.ZIndex = 54
    Label.Parent = Holder

    local Dot = Instance.new("Frame")
    Dot.Size = UDim2.new(0, 32, 0, 16)
    Dot.Position = UDim2.new(1, -40, 0.5, 0)
    Dot.AnchorPoint = Vector2.new(0, 0.5)
    Dot.BackgroundColor3 = Color3.fromRGB(40, 40, 48)
    Dot.BorderSizePixel = 0
    Dot.ZIndex = 54
    Dot.Parent = Holder

    local DotCorner = Instance.new("UICorner")
    DotCorner.CornerRadius = UDim.new(1, 0)
    DotCorner.Parent = Dot

    local Knob = Instance.new("Frame")
    Knob.Size = UDim2.new(0, 12, 0, 12)
    Knob.Position = UDim2.new(0, 2, 0.5, 0)
    Knob.AnchorPoint = Vector2.new(0, 0.5)
    Knob.BackgroundColor3 = THEME.SUBTEXT
    Knob.BorderSizePixel = 0
    Knob.ZIndex = 55
    Knob.Parent = Dot

    local KnobCorner = Instance.new("UICorner")
    KnobCorner.CornerRadius = UDim.new(1, 0)
    KnobCorner.Parent = Knob

    local function apply()
        pcall(function()
            if state then
                TweenService:Create(Dot, TweenInfo.new(0.2), {BackgroundColor3 = THEME.ACCENT}):Play()
                TweenService:Create(Knob, TweenInfo.new(0.2), {Position = UDim2.new(1, -14, 0.5, 0), BackgroundColor3 = THEME.TEXT}):Play()
            else
                TweenService:Create(Dot, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(40, 40, 48)}):Play()
                TweenService:Create(Knob, TweenInfo.new(0.2), {Position = UDim2.new(0, 2, 0.5, 0), BackgroundColor3 = THEME.SUBTEXT}):Play()
            end
        end)
    end

    apply()

    local Click = Instance.new("TextButton")
    Click.Size = UDim2.fromScale(1, 1)
    Click.BackgroundTransparency = 1
    Click.Text = ""
    Click.ZIndex = 56
    Click.Parent = Holder

    Click.MouseButton1Click:Connect(function()
        state = not state
        apply()
        if callback then
            local ok, err = pcall(callback, state)
            if not ok then setStatus("error: " .. tostring(err)) end
        end
    end)

    return Holder
end

