        if type(setclipboard) == "function" then
            pcall(setclipboard, game.JobId)
            setStatus("job id copied")
        end
    end)
    createButton(t, "Refresh ESP", function()
        clearAllESP()
        task.wait(0.1)
        refreshAllESP()
        setStatus("esp refreshed")
    end)
end

switchTab("Farm")
pcall(function()
    Tabs["Farm"].Button.BackgroundTransparency = 0
    Tabs["Farm"].Button.BackgroundColor3 = THEME.ACCENT
    Tabs["Farm"].Button.TextColor3 = THEME.TEXT
end)

-- FAB
local Fab = Instance.new("TextButton")
Fab.Size = UDim2.new(0, 48, 0, 48)
Fab.Position = UDim2.new(0, 15, 0.5, -24)
Fab.BackgroundColor3 = THEME.ACCENT
Fab.BorderSizePixel = 0
Fab.Text = "F"
Fab.TextColor3 = THEME.TEXT
Fab.Font = Enum.Font.GothamBlack
Fab.TextSize = 20
Fab.AutoButtonColor = false
Fab.Active = true
Fab.ZIndex = 200
Fab.Parent = ScreenGui

local FabCorner = Instance.new("UICorner")
FabCorner.CornerRadius = UDim.new(1, 0)
FabCorner.Parent = Fab

do
    local dragging, dragStart, startPos
    Fab.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true; dragStart = input.Position; startPos = Fab.Position
        end
    end)
    Fab.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = false
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseMovement) then
            local delta = input.Position - dragStart
            Fab.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        end
    end)
end

Fab.MouseButton1Click:Connect(function()
    Main.Visible = not Main.Visible
end)

-- Автопоказ меню
task.spawn(function()
    task.wait(1)
    Main.Visible = true
    setStatus("etfb loaded.")
end)

print("[ETFB Fox] Framework loaded")
