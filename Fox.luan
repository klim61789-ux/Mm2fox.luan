--[[
    ETFB Fox Framework v1.1
    Escape Tsunami For Brainrots
    Ремоуты: SellAll, UpgradeBase, UpgradeSpeed, Rebirth, TakeFreeEpic,
             CollectMoney, UpgradeBrainrot, UpgradeCarry, BuyGear
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local CoreGui = game:GetService("CoreGui")
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local LP = Players.LocalPlayer

-- ========== SAFE PARENT ==========
local function getParent()
    if type(gethui) == "function" then
        local ok, hui = pcall(gethui)
        if ok and hui and typeof(hui) == "Instance" then return hui end
    end
    if CoreGui then return CoreGui end
    return LP:WaitForChild("PlayerGui")
end
local GUI_PARENT = getParent()

pcall(function()
    local old = GUI_PARENT:FindFirstChild("ETFB_FoxUI")
    if old then old:Destroy() end
end)

-- ========== REMOTES ==========
local RF = ReplicatedStorage:WaitForChild("RemoteFunctions", 10)
local RE = ReplicatedStorage:WaitForChild("RemoteEvents", 10)

local Remotes = {}
if RF then
    Remotes.SellAll         = RF:FindFirstChild("SellAll")
    Remotes.SellTool        = RF:FindFirstChild("SellTool")
    Remotes.GetSellAmount   = RF:FindFirstChild("GetSellAmount")
    Remotes.GetCollected    = RF:FindFirstChild("GetCollectedBrainrots")
    Remotes.TakeFreeEpic    = RF:FindFirstChild("TakeFreeEpic")
    Remotes.UpgradeBrainrot = RF:FindFirstChild("UpgradeBrainrot")
    Remotes.UpgradeBase     = RF:FindFirstChild("UpgradeBase")
    Remotes.UpgradeSpeed    = RF:FindFirstChild("UpgradeSpeed")
    Remotes.UpgradeCarry    = RF:FindFirstChild("UpgradeCarry")
    Remotes.Rebirth         = RF:FindFirstChild("Rebirth")
    Remotes.BuyGear         = RF:FindFirstChild("BuyGear")
end
if RE then
    Remotes.CollectMoney    = RE:FindFirstChild("CollectMoney")
    Remotes.DropBrainrot    = RE:FindFirstChild("DropBrainrot")
    Remotes.EntityHit       = RE:FindFirstChild("EntityHit")
    Remotes.SlapPlayer      = RE:FindFirstChild("SlapPlayer")
end

-- ========== THEME ==========
local THEME = {
    BG        = Color3.fromRGB(12, 12, 16),
    PANEL     = Color3.fromRGB(20, 20, 26),
    ACCENT    = Color3.fromRGB(60, 180, 240),
    ACCENT2   = Color3.fromRGB(90, 220, 255),
    TEXT      = Color3.fromRGB(235, 235, 240),
    SUBTEXT   = Color3.fromRGB(150, 150, 160),
    STROKE    = Color3.fromRGB(45, 45, 55),
    BRAINROT  = Color3.fromRGB(255, 180, 60),
}

-- ========== ROOT GUI ==========
local ScreenGui = Instance.new("ScreenGui")
ScreenGui.Name = "ETFB_FoxUI"
ScreenGui.ResetOnSpawn = false
ScreenGui.IgnoreGuiInset = true
ScreenGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
ScreenGui.DisplayOrder = 999
ScreenGui.Parent = GUI_PARENT

-- ========== УТИЛИТЫ ==========
local function callRF(rf, ...)
    if not rf then return nil end
    local args = {...}
    local ok, res = pcall(function()
        return rf:InvokeServer(table.unpack(args))
    end)
    if ok then return res end
    return nil
end

local function fireRE(re, ...)
    if not re then return false end
    local args = {...}
    local ok = pcall(function()
        re:FireServer(table.unpack(args))
    end)
    return ok
end

-- ========== BRAINROT ESP ==========
local ESP_State = { Enabled = false, Objects = {} }

local function clearESP(obj)
    local data = ESP_State.Objects[obj]
    if data then
        pcall(function() if data.Highlight then data.Highlight:Destroy() end end)
        pcall(function() if data.Billboard then data.Billboard:Destroy() end end)
        ESP_State.Objects[obj] = nil
    end
end

local function clearAllESP()
    local keys = {}
    for k, _ in pairs(ESP_State.Objects) do table.insert(keys, k) end
    for _, k in ipairs(keys) do clearESP(k) end
    ESP_State.Objects = {}
end

local function isBrainrot(obj)
    if not obj or not obj:IsA("BasePart") then return false end
    if obj:GetAttribute("BrainrotId") then return true end
    if obj.Name:lower():find("brainrot") then return true end
    return false
end

local function applyESP(obj)
    if not isBrainrot(obj) then return end
    clearESP(obj)

    local hl = Instance.new("Highlight")
    hl.Name = "FoxESP_HL"
    hl.Adornee = obj
    hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    hl.FillColor = THEME.BRAINROT
    hl.FillTransparency = 0.5
    hl.OutlineColor = THEME.BRAINROT
    hl.OutlineTransparency = 0
    hl.Parent = obj

    local bb = Instance.new("BillboardGui")
    bb.Name = "FoxESP_BB"
    bb.Adornee = obj
    bb.Size = UDim2.new(0, 140, 0, 30)
    bb.StudsOffset = Vector3.new(0, 3, 0)
    bb.AlwaysOnTop = true
    bb.Parent = obj

    local txt = Instance.new("TextLabel")
    txt.Size = UDim2.fromScale(1, 1)
    txt.BackgroundTransparency = 1
    txt.TextColor3 = THEME.BRAINROT
    txt.Font = Enum.Font.GothamBold
    txt.TextSize = 14
    txt.TextStrokeTransparency = 0.5
    txt.Text = obj.Name
    txt.Parent = bb

    ESP_State.Objects[obj] = {Highlight = hl, Billboard = bb}
end

local function refreshAllESP()
    if not ESP_State.Enabled then return end
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if isBrainrot(obj) then applyESP(obj) end
    end
end

local function setESP(state)
    ESP_State.Enabled = state
    if state then refreshAllESP() else clearAllESP() end
end

-- ========== AUTO-COLLECT ==========
local Collect_State = { Enabled = false, Range = 30 }

local function findNearestBrainrot()
    local char = LP.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return nil end
    local best, bestDist = nil, Collect_State.Range
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if isBrainrot(obj) then
            local d = (obj.Position - hrp.Position).Magnitude
            if d < bestDist then bestDist = d; best = obj end
        end
    end
    return best
end

local function doCollect()
    local obj = findNearestBrainrot()
    if not obj then return end
    -- Если у нас есть CollectMoney - жмём
    fireRE(Remotes.CollectMoney)
end

-- ========== AUTO-UPGRADE ==========
local Upgrade_State = {
    Base = false, Speed = false, Carry = false, Brainrot = false,
    Interval = 2,
}

local function doUpgrades()
    if Upgrade_State.Base     then callRF(Remotes.UpgradeBase)     end
    if Upgrade_State.Speed    then callRF(Remotes.UpgradeSpeed)    end
    if Upgrade_State.Carry    then callRF(Remotes.UpgradeCarry)    end
    if Upgrade_State.Brainrot then callRF(Remotes.UpgradeBrainrot) end
end

-- ========== AUTO-REBIRTH ==========
local Rebirth_State = { Enabled = false, Interval = 5 }

local function doRebirth()
    callRF(Remotes.Rebirth)
end

-- ========== AUTO-SELL ==========
local Sell_State = { Enabled = false, Interval = 3 }

local function doSell()
    callRF(Remotes.SellAll)
end

-- ========== TELEPORT TO SAFE ZONE ==========
local function teleportToSafeZone()
    local char = LP.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    local names = {"SafeZone", "SafeArea", "SpawnZone", "BasePlot", "Base"}
    for _, n in ipairs(names) do
        local obj = Workspace:FindFirstChild(n, true)
        if obj and obj:IsA("BasePart") then
            hrp.CFrame = obj.CFrame + Vector3.new(0, 5, 0)
            return true
        end
    end
    local spawn = Workspace:FindFirstChildOfClass("SpawnLocation")
    if spawn then hrp.CFrame = spawn.CFrame + Vector3.new(0, 5, 0) return true end
    return false
end

-- ========== MAIN LOOPS ==========
task.spawn(function()
    while true do
        task.wait(0.5)
        if Collect_State.Enabled then doCollect() end
    end
end)

task.spawn(function()
    while true do
        task.wait(Upgrade_State.Interval)
        doUpgrades()
    end
end)

task.spawn(function()
    while true do
        task.wait(Rebirth_State.Interval)
        if Rebirth_State.Enabled then doRebirth() end
    end
end)

task.spawn(function()
    while true do
        task.wait(Sell_State.Interval)
        if Sell_State.Enabled then doSell() end
    end
end)

task.spawn(function()
    while true do
        task.wait(1)
        if ESP_State.Enabled then refreshAllESP() end
    end
end)

