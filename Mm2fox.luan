-- DRAG
local dragging, dragStart, startPos
header.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
    or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startPos = main.Position
    end
end)
header.InputChanged:Connect(function(input)
    if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
    or input.UserInputType == Enum.UserInputType.Touch) then
        local delta = input.Position - dragStart
        main.Position = UDim2.new(
            startPos.X.Scale, startPos.X.Offset + delta.X,
            startPos.Y.Scale, startPos.Y.Offset + delta.Y
        )
    end
end)
header.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
    or input.UserInputType == Enum.UserInputType.Touch then
        dragging = false
    end
end)

local collapsed = false
collapseIcon.MouseButton1Click:Connect(function()
    collapsed = not collapsed
    local targetSize = collapsed and UDim2.new(0, 200, 0, 35) or UDim2.new(0, 200, 0, 195)
    TweenService:Create(main, TweenInfo.new(0.2, Enum.EasingStyle.Quad), {Size = targetSize}):Play()
    collapseIcon.Text = collapsed and "▲" or "▼"
    espButton.Visible = not collapsed
    invisibleBtn.Visible = not collapsed
    statusFrame.Visible = not collapsed
end)

espButton.MouseButton1Click:Connect(function()
    espEnabled = not espEnabled
    espButton.Text = espEnabled and "ESP: ON" or "ESP: OFF"
    espButton.BackgroundColor3 = espEnabled and ACCENT or BG_OFF
    statusDot.BackgroundColor3 = espEnabled and DOT_ON or DOT_OFF
    if not espEnabled then
        for _, p in ipairs(Players:GetPlayers()) do removeESP(p) end
    else
        for _, p in ipairs(Players:GetPlayers()) do createESP(p) end
    end
end)

shootBtn.MouseButton1Click:Connect(function()
    autoShootEnabled = not autoShootEnabled
    shootBtn.Text = autoShootEnabled and "AUTO SHOOT\nON" or "AUTO SHOOT\nOFF"
    shootBtn.BackgroundColor3 = autoShootEnabled and ACCENT or BG_OFF
end) -- ============ MM2 Fox Script (Part 2/2) ============
local function hasItem(container, name)
    if not container then return false end
    for _, item in ipairs(container:GetChildren()) do
        if item.Name == name then return true end
    end
    return false
end

local function getPlayerRole(player)
    local char = player.Character
    if not char then return "Menu" end
    local backpack = player:FindFirstChild("Backpack")
    if hasItem(backpack, "Knife") or hasItem(char, "Knife") then
        return "Murderer"
    end
    if hasItem(backpack, "Gun") or hasItem(char, "Gun") then
        return "Sheriff"
    end
    return "Innocent"
end

local function getESPColor(player)
    local char = player.Character
    if not char then return COLORS.Menu end
    local humanoid = char:FindFirstChildOfClass("Humanoid")
    if not humanoid then return COLORS.Menu end
    if humanoid.Health <= 0 then return COLORS.Menu end
    local role = getPlayerRole(player)
    return COLORS[role] or COLORS.Menu
end

local function isLocalSheriff()
    local char = LocalPlayer.Character
    if not char then return false end
    local backpack = LocalPlayer:FindFirstChild("Backpack")
    return hasItem(backpack, "Gun") or hasItem(char, "Gun")
end

local function isSheriffAlive()
    for _, p in ipairs(Players:GetPlayers()) do
        local char = p.Character
        if char then
            local hum = char:FindFirstChildOfClass("Humanoid")
            if hum and hum.Health > 0 and getPlayerRole(p) == "Sheriff" then
                return true
            end
        end
    end
    return false
end

local function applyColor(player)
    if not espEnabled then return end
    local char = player.Character
    if not char then return end
    local hl = char:FindFirstChild("FoxESP")
    if not hl then return end
    local color = getESPColor(player)
    hl.FillColor = color
    hl.OutlineColor = color
end

function createESP(player)
    if player == LocalPlayer then return end
    if not espEnabled then return end
    local char = player.Character
    if not char then return end
    if char:FindFirstChild("FoxESP") then return end
    local hl = Instance.new("Highlight")
    hl.Name = "FoxESP"
    hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    hl.FillTransparency = 0.5
    hl.OutlineTransparency = 0
    local color = getESPColor(player)
    hl.FillColor = color
    hl.OutlineColor = color
    hl.Parent = char
end

function removeESP(player)
    local char = player.Character
    if not char then return end
    local hl = char:FindFirstChild("FoxESP")
    if hl then hl:Destroy() end
end

local function hookHumanoid(player, char)
    local humanoid = char:FindFirstChildOfClass("Humanoid")
    if not humanoid then return end
    humanoid.Died:Connect(function() applyColor(player) end)
    humanoid.HealthChanged:Connect(function(h)
        if h <= 0 then applyColor(player) end
    end)
end

local function onCharacter(player)
    removeESP(player)
    task.wait(0.5)
    createESP(player)
    local char = player.Character
    if char then
        hookHumanoid(player, char)
        char.ChildAdded:Connect(function() task.wait(0.1); applyColor(player) end)
        char.ChildRemoved:Connect(function() task.wait(0.1); applyColor(player) end)
    end
end

local function onPlayer(player)
    player.CharacterAdded:Connect(function() onCharacter(player) end)
    if player.Character then onCharacter(player) end
end

local function watchBackpack(player)
    local backpack = player:FindFirstChild("Backpack")
    if not backpack then return end
    backpack.ChildAdded:Connect(function() task.wait(0.1); applyColor(player) end)
    backpack.ChildRemoved:Connect(function() task.wait(0.1); applyColor(player) end)
end

local function countMurderers()
    local c = 0
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer then
            local char = p.Character
            if char then
                local hum = char:FindFirstChildOfClass("Humanoid")
                if hum and hum.Health > 0 and getPlayerRole(p) == "Murderer" then
                    c = c + 1
                end
            end
        end
    end
    return c
end

local function countAlive()
    local c = 0
    for _, p in ipairs(Players:GetPlayers()) do
        local char = p.Character
        if char then
            local hum = char:FindFirstChildOfClass("Humanoid")
            if hum and hum.Health > 0 then c = c + 1 end
        end
    end
    return c
end

local invisSaved = {}
local function setInvisible(state)
    local char = LocalPlayer.Character
    if not char then return end
    if state then
        invisSaved = {}
        for _, obj in ipairs(char:GetDescendants()) do
            if obj:IsA("BasePart") then
                invisSaved[obj] = obj.Transparency
                obj.Transparency = 1
            elseif obj:IsA("Decal") or obj:IsA("Texture") then
                invisSaved[obj] = obj.Transparency
                obj.Transparency = 1
            end
        end
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum then
            hum.NameDisplayDistance = 0
            hum.HealthDisplayDistance = 0
        end
    else
        for obj, t in pairs(invisSaved) do
            if obj and obj.Parent then
                pcall(function() obj.Transparency = t end)
            end
        end
        invisSaved = {}
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum then
            hum.NameDisplayDistance = 100
            hum.HealthDisplayDistance = 100
        end
    end
end

invisibleBtn.MouseButton1Click:Connect(function()
    invisibleEnabled = not invisibleEnabled
    invisibleBtn.Text = invisibleEnabled and "INVISIBLE: ON" or "INVISIBLE: OFF"
    invisibleBtn.BackgroundColor3 = invisibleEnabled and ACCENT or BG_OFF
    setInvisible(invisibleEnabled)
end)

local function isInViewport(pos)
    local sp, onScreen = camera:WorldToViewportPoint(pos)
    local vp = camera.ViewportSize
    if not onScreen then return false, nil end
    if sp.Z <= 0 then return false, nil end
    if sp.X < 0 or sp.X > vp.X then return false, nil end
    if sp.Y < 0 or sp.Y > vp.Y then return false, nil end
    return true, sp
end

local function getVisibleMurderers()
    local result = {}
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character then
            local hum = p.Character:FindFirstChildOfClass("Humanoid")
            if hum and hum.Health > 0 and getPlayerRole(p) == "Murderer" then
                local head = p.Character:FindFirstChild("Head")
                if head then
                    local visible, sp = isInViewport(head.Position)
                    if visible then
                        local dist = (camera.CFrame.Position - head.Position).Magnitude
                        table.insert(result, {player = p, head = head, dist = dist, screen = sp})
                    end
                end
            end
        end
    end
    table.sort(result, function(a, b) return a.dist < b.dist end)
    return result
end

local function getLocalGun()
    local char = LocalPlayer.Character
    if not char then return nil end
    local gun = char:FindFirstChild("Gun")
    if gun and gun:IsA("Tool") then return gun end
    local backpack = LocalPlayer:FindFirstChild("Backpack")
    if backpack then
        gun = backpack:FindFirstChild("Gun")
        if gun and gun:IsA("Tool") then return gun end
    end
    return nil
end

local function fireGun(gun, screenPos)
    if not gun then return end
    local x, y
    if screenPos then
        x = math.floor(screenPos.X)
        y = math.floor(screenPos.Y)
    else
        local vp = camera.ViewportSize
        x = math.floor(vp.X / 2)
        y = math.floor(vp.Y / 2)
    end
    pcall(function() gun:Activate() end)
    task.wait(0.03)
    pcall(function()
        VirtualInputManager:SendMouseButtonEvent(x, y, 0, true, game, 0)
        task.wait(0.03)
        VirtualInputManager:SendMouseButtonEvent(x, y, 0, false, game, 0)
    end)
    task.wait(0.03)
    pcall(function()
        for _, child in ipairs(gun:GetDescendants()) do
            if child:IsA("RemoteEvent") then
                child:FireServer()
            elseif child:IsA("RemoteFunction") then
                child:InvokeServer()
            end
        end
    end)
    pcall(function()
        VirtualUser:ClickButton1(Vector2.new(x, y))
    end)
end

local function findFreeGun()
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("Tool") and obj.Name == "Gun" then
            local parent = obj.Parent
            local isHeld = false
            for _, p in ipairs(Players:GetPlayers()) do
                if parent == p.Character or parent == p:FindFirstChild("Backpack") then
                    isHeld = true
                    break
                end
            end
            if not isHeld then return obj end
        end
    end
    return nil
end

tpBtn.MouseButton1Click:Connect(function()
    if not LocalPlayer.Character then return end
    local gun = findFreeGun()
    if gun then
        pcall(function()
            LocalPlayer.Character:PivotTo(CFrame.new(gun.Position + Vector3.new(0, 3, 0)))
        end)
        tpBtn.Visible = false
    end
end)

for _, p in ipairs(Players:GetPlayers()) do onPlayer(p) end
Players.PlayerAdded:Connect(onPlayer)
Players.PlayerRemoving:Connect(removeESP)
for _, p in ipairs(Players:GetPlayers()) do watchBackpack(p) end
Players.PlayerAdded:Connect(function(p)
    p.ChildAdded:Connect(function(child)
        if child.Name == "Backpack" then watchBackpack(p) end
    end)
end)

LocalPlayer.CharacterAdded:Connect(function()
    if invisibleEnabled then
        task.wait(0.5)
        setInvisible(true)
    end
end)

task.spawn(function()
    while task.wait(0.5) do
        if espEnabled then
            for _, p in ipairs(Players:GetPlayers()) do
                if p ~= LocalPlayer and p.Character then
                    if not p.Character:FindFirstChild("FoxESP") then
                        createESP(p)
                    else
                        applyColor(p)
                    end
                end
            end
        end
    end
end)

task.spawn(function()
    while task.wait(0.5) do
        local sheriff = isLocalSheriff()
        shootBtn.Visible = sheriff
        if not sheriff and autoShootEnabled then
            autoShootEnabled = false
            shootBtn.Text = "AUTO SHOOT\nOFF"
            shootBtn.BackgroundColor3 = BG_OFF
        end
        roleLabel.Text = "Role: " .. getPlayerRole(LocalPlayer)
        murdererLabel.Text = "Murderers: " .. countMurderers()
        aliveLabel.Text = "Alive: " .. countAlive()
    end
end)

task.spawn(function()
    while task.wait(0.15) do
        if not autoShootEnabled then continue end
        if not isLocalSheriff() then continue end
        local targets = getVisibleMurderers()
        if #targets == 0 then continue end
        local target = targets[1]
        if not LocalPlayer.Character then continue end
        local _, sp = isInViewport(target.head.Position)
        local gun = getLocalGun()
        if gun then fireGun(gun, sp) end
    end
end)

task.spawn(function()
    while task.wait(0.5) do
        local sheriffAlive = isSheriffAlive()
        local freeGun = findFreeGun()
        if (not sheriffAlive) and freeGun then
            tpBtn.Visible = true
        else
            tpBtn.Visible = false
        end
    end
end)

print("[FOX MM2] Script loaded OK")
